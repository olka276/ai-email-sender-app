# Copy to .env to override defaults (docker compose reads it automatically).
# Every variable is optional. Uncommented values are compose-level defaults;
# commented ones are application settings whose defaults live in app/config.py.

# --- Host ports ---
API_PORT=8000
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025

# --- LLM ---
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_THREAD=10
# OLLAMA_NUM_CTX=2048
# OLLAMA_NUM_PREDICT=64

# --- SMTP ---
# SMTP_SENDER=agent@my-app.local
# SMTP_TIMEOUT=10

# --- Service addresses (inside the compose network) ---
# OLLAMA_BASE_URL=http://ollama:11434
# SMTP_HOST=mailhog
# SMTP_PORT=1025

# --- Throttling (tune to your hardware) ---
# SEMAPHORE_LIMIT=3
# RPM_LIMIT_MAX_RATE=10
# RPM_LIMIT_TIME_PERIOD=60

# --- Logging ---
# LOG_LEVEL=INFO
